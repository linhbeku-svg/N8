
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="QuanLySanBong.SiteMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Hệ thống quản lý sân bóng</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body class="bg-light">

    <!-- FORM CHINH -->
    <form id="form1" runat="server" enctype="multipart/form-data">

        <div class="container-fluid">
            <div class="row min-vh-100">

                <!-- MENU BEN TRAI -->
                <div class="col-12 col-md-3 col-lg-2 bg-dark text-white p-0">

                    <div class="p-3 border-bottom border-secondary">
                        <h5 class="mb-0 text-center">
                            <i class="fa-solid fa-futbol text-primary me-2"></i>
                            QUẢN LÝ SÂN BÓNG
                        </h5>
                    </div>

                    <div class="p-3">

                        <!-- TONG QUAN -->
                        <div class="text-secondary small fw-bold mb-2">
                            TỔNG QUAN
                        </div>

                        <div class="list-group list-group-flush mb-3">

                            <asp:HyperLink ID="lnkTrangChu" runat="server"
                                NavigateUrl="~/Default.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-house me-2"></i>
                                Trang chủ
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkThongKe" runat="server"
                                NavigateUrl="~/ThongKe.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-chart-column me-2"></i>
                                Thống kê
                            </asp:HyperLink>

                        </div>

                        <!-- QUAN LY -->
                        <div class="text-secondary small fw-bold mb-2">
                            QUẢN LÝ
                        </div>

                        <div class="list-group list-group-flush mb-3">

                            <asp:HyperLink ID="lnkSanBong" runat="server"
                                NavigateUrl="~/SanBong.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-futbol me-2"></i>
                                Sân bóng
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkBangGia" runat="server"
                                NavigateUrl="~/BangGia.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-tags me-2"></i>
                                Bảng giá
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkKhachHang" runat="server"
                                NavigateUrl="~/KhachHang.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-users me-2"></i>
                                Khách hàng
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkDatSan" runat="server"
                                NavigateUrl="~/DatSan.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-calendar-check me-2"></i>
                                Đặt sân
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkDichVu" runat="server"
                                NavigateUrl="~/DichVu.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-bell-concierge me-2"></i>
                                Dịch vụ
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkHoaDon" runat="server"
                                NavigateUrl="~/HoaDon.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-file-invoice me-2"></i>
                                Hóa đơn
                            </asp:HyperLink>

                            <asp:HyperLink ID="lnkThanhToan" runat="server"
                                NavigateUrl="~/ThanhToan.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-credit-card me-2"></i>
                                Thanh toán
                            </asp:HyperLink>

                        </div>

                        <!-- HE THONG -->
                        <div class="text-secondary small fw-bold mb-2">
                            HỆ THỐNG
                        </div>

                        <div class="list-group list-group-flush">

                            <asp:HyperLink ID="lnkTaiKhoan" runat="server"
                                NavigateUrl="~/TaiKhoan.aspx"
                                CssClass="list-group-item list-group-item-action bg-dark text-white border-secondary">
                                <i class="fa-solid fa-user-gear me-2"></i>
                                Tài khoản
                            </asp:HyperLink>

                        </div>

                    </div>
                </div>

                <!-- KHU VUC NOI DUNG -->
                <div class="col-12 col-md-9 col-lg-10 p-0">

                    <!-- THANH TREN -->
                    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-3 py-3">

                        <span class="navbar-brand fw-bold text-primary">
                            HỆ THỐNG QUẢN LÝ SÂN BÓNG
                        </span>

                        <div class="ms-auto d-flex align-items-center gap-3">

                            <div class="text-end">
                                <div class="fw-bold">
                                    <asp:Label ID="lblHoTen" runat="server" />
                                </div>

                                <small class="text-secondary">
                                    <asp:Label ID="lblQuyen" runat="server" />
                                </small>
                            </div>

                            <asp:LinkButton ID="btnDangXuat" runat="server"
                                CssClass="btn btn-outline-danger btn-sm"
                                OnClick="btnDangXuat_Click"
                                CausesValidation="false">
                                <i class="fa-solid fa-right-from-bracket me-1"></i>
                                Đăng xuất
                            </asp:LinkButton>

                        </div>

                    </nav>

                    <!-- NOI DUNG TUNG TRANG -->
                    <main class="container-fluid p-3 p-md-4">

                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>

                    </main>

                    <!-- CHAN TRANG -->
                    <footer class="bg-white border-top text-center text-secondary p-3">
                        © 2026 - Hệ thống quản lý sân bóng
                    </footer>

                </div>

            </div>
        </div>

    </form>

    <!-- BOOTSTRAP JAVASCRIPT -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
