<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- KET NOI DATABASE SQL SERVER -->
	<connectionStrings>
		<add name="QuanLySanBong"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QuanLySanBong;Integrated Security=True;Encrypt=False"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- CAU HINH ASP.NET -->
	<system.web>

		<!-- PHIEN BAN .NET FRAMEWORK -->
		<compilation debug="true" targetFramework="4.7.2" />

		<httpRuntime targetFramework="4.7.2" />

		<!-- CAU HINH SESSION -->
		<sessionState mode="InProc"
					  timeout="30" />

		<!-- MA HOA -->
		<pages controlRenderingCompatibilityVersion="4.0"
			   clientIDMode="AutoID" />

	</system.web>

</configuration>
